# Keep credentials out of source control and never expose secrets to the browser.
# Set this to the canonical HTTPS origin before a production build so metadata,
# canonical links, Open Graph URLs, robots.txt, and sitemap.xml use your domain.
# Configure this in Vercel for Production, Preview, and Development; preview
# deployments use the production origin for canonical links and are noindex.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy anon keys are supported if your project does not have publishable keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Consultation profile contact links shown publicly on /consultation.
NEXT_PUBLIC_CONSULTATION_EMAIL=your-advisory-email@example.com
NEXT_PUBLIC_CONSULTATION_WHATSAPP=your-international-number-with-country-code
NEXT_PUBLIC_CONTACT_EMAIL=your-contact-email@example.com
NEXT_PUBLIC_CONTACT_WHATSAPP=your-international-number-with-country-code
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company

# Server-only key for contact/booking requests and private rate-limit hashing.
# Never add NEXT_PUBLIC_ to this value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only OpenAI Responses API credentials for the financial assistant.
# Never add NEXT_PUBLIC_ to this key. OPENAI_MODEL is optional.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna

# Optional booking request email notifications (Resend).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=WealthTogether <bookings@your-domain.example>
CONSULTATION_NOTIFICATION_EMAIL=your-advisory-email@example.com
CONTACT_NOTIFICATION_EMAIL=your-contact-email@example.com
